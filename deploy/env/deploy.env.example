# /opt/msu-club/.env — ค่าของ compose และสคริปต์ (APP_TAG ถูกเขียนโดย deploy.sh)
APP_TAG=
IMAGE_PREFIX=ghcr.io/tanasats/msustaffclub2026

# สำรองข้อมูล (scripts/backup.sh)
BACKUP_DIR=/opt/msu-club/backups
BACKUP_KEEP_DAYS=14
# ปลายทางนอก VM สำหรับ rsync เช่น backup@nas.msu.ac.th:/backups/msu-club (ว่าง = ยังไม่คัดลอกออก — ควรกำหนดโดยเร็ว)
BACKUP_REMOTE=
