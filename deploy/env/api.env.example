# /opt/msu-club/env/api.env (chmod 600) — ห้าม commit ค่าจริง
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# nginx บน host 1 ตัว → เชื่อ X-Forwarded-For 1 hop (rate limit นับตาม IP จริงของผู้ใช้)
TRUST_PROXY=1

WEB_URL=https://club.msu.ac.th
CORS_ORIGIN=https://club.msu.ac.th
# รหัสผ่านเดียวกับ env/postgres.env, host = ชื่อ service ใน compose
DATABASE_URL=postgres://app:<POSTGRES_PASSWORD>@postgres:5432/app_prod

# Google OAuth (Google Cloud Console → Authorized redirect URI ต้องตรงทุกตัวอักษร)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://club.msu.ac.th/api/auth/google/callback
SESSION_COOKIE_NAME=msu_club_session
SESSION_TTL_DAYS=7
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
ALLOWED_EMAIL_DOMAINS=msu.ac.th
# ใช้ครั้งแรกตอน seed super_admin
INITIAL_SUPER_ADMIN_EMAIL=

ERP_HR_STAFFINFO_URL=https://erp.msu.ac.th/service/api/staffinfo
ERP_HR_TIMEOUT_MS=5000

# Garage: API คุยภายใน docker network, browser ใช้โดเมนเดียวกับเว็บ (nginx ส่ง /club-files/ ไป Garage)
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=https://club.msu.ac.th
S3_REGION=garage
S3_BUCKET=club-files
S3_FORCE_PATH_STYLE=true
# scripts/garage-setup.sh เขียนค่า 2 ตัวนี้ให้
S3_ACCESS_KEY=
S3_SECRET_KEY=
