PORT=4000
NODE_ENV=development
LOG_LEVEL=info
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://app:app@localhost:5432/app_dev
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test

# Google OAuth (สร้างที่ Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
SESSION_COOKIE_NAME=msu_club_session
SESSION_TTL_DAYS=7
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
INITIAL_SUPER_ADMIN_EMAIL=
# คั่นด้วยจุลภาค เช่น msu.ac.th (ว่าง = ไม่จำกัดโดเมน)
ALLOWED_EMAIL_DOMAINS=msu.ac.th

# ERP-HR (ข้อมูลบุคลากร)
ERP_HR_STAFFINFO_URL=https://erp.msu.ac.th/service/api/staffinfo
ERP_HR_TIMEOUT_MS=5000

# Storage (Garage) ได้ค่า key จาก docker/garage/setup.sh
S3_ENDPOINT=http://localhost:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=app-files
# bucket แยกสำหรับรัน test (เหมือน app_test แยกจาก app_dev)
TEST_S3_BUCKET=app-files-test
S3_FORCE_PATH_STYLE=true
