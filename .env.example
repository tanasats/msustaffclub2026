# ตัวแปรสำหรับ docker compose (คัดลอกเป็น .env ที่ root)
# ถ้า port ชนกับโปรแกรมอื่นหรือระบบอื่นบนเครื่อง ให้เปลี่ยนที่นี่ แล้วแก้ URL ใน apps/api/.env ให้ตรงกัน
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app

GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
# สร้างด้วย: openssl rand -hex 32
GARAGE_RPC_SECRET=
# สร้างด้วย: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
